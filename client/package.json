{
  "name": "skills-catalog",
  "version": "0.1.0",
  "description": "The skills catalog on your machine: the assistant's tools as an MCP server over stdio (skills-catalog mcp); the CLI and the installer join next",
  "private": true,
  "type": "module",
  "bin": {
    "skills-catalog": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "test": "vitest run --project fast",
    "test:slow": "vitest run --project slow --passWithNoTests",
    "test:all": "vitest run",
    "test:mcp": "vitest run --project fast test/mcp.test.ts",
    "test:publish": "vitest run --project fast test/publish.test.ts test/publish-steps.test.ts test/publish-folder.test.ts",
    "test:activity": "vitest run --project fast test/activity.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "mutate": "node test/mutations.mjs",
    "setup-doc": "node --disable-warning=ExperimentalWarning scripts/setup-doc.ts"
  },
  "dependencies": {
    "@skills-catalog/core": "file:../core"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
